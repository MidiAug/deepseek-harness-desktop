{
  "name": "deepseek-harness-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:release": "node scripts/check-release.mjs",
    "test:unit": "node --test --experimental-strip-types src/shell/errors/recoveryMatrix.test.ts src/shell/errors/parseFaultDisplay.test.ts src/shell/hostProgressMap.test.ts src/shell/settings.test.ts src/shell/formatPathShort.test.ts",
    "audit:snapshot": "node scripts/audit-system-snapshot.mjs",
    "audit:runtime": "node scripts/audit-runtime-probe.mjs",
    "audit:cdp": "node scripts/audit-cdp-capture.mjs",
    "audit:matrix": "node scripts/audit-run-matrix.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@9.15.9"
}
